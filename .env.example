# =============================================================================
# Todobee environment
# Copy this file to .env in the repository root, fill in the blanks, then:
#   npm install
#   npm run dev
# The browser is http://localhost:3000. The API is http://127.0.0.1:4000.
# Docker publishes 3000 for the real app. The demo container publishes 5000.
# Point demo.todobee.com at port 5000. The demo has no login, database, email, or Stripe.
# PORT below stays 4000 for local dev; the container does not listen on 4000.
# =============================================================================

# Public origin of the app. No trailing slash.
# Local:  http://localhost:3000
# Docker: https://your-domain
# Sign-in, Stripe, and invite links use the address the browser actually opened
# when the proxy sends a Host header. Set this to that same https domain too.
APP_URL=http://localhost:3000

# Signs the session cookie and encrypts Google refresh tokens. At least 16 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-with-a-long-random-string

# API listen port for local dev only. Docker publishes 3000 and ignores this.
PORT=4000

# Where Next.js rewrites /api during local dev. Not used by the browser directly.
API_INTERNAL_URL=http://127.0.0.1:4000

# -----------------------------------------------------------------------------
# PocketBase cloud  (accounts, roles, subscription rows, and the Drive cache)
# This repo does not run PocketBase. Point these at the instance you host
# (PocketHost, Fly, your own server, etc.). No trailing slash.
# The API logs in as that superuser and creates the app collections if they
# are missing. It never stores the database in this project.
#
# Superuser: the email and password from your PocketBase admin (_superusers).
# Dashboard: https://YOUR_PB_URL/_/
# -----------------------------------------------------------------------------
PB_URL=https://your-instance.pockethost.io
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Google Cloud  (sign-in + the admin's Google Drive)
# Console: https://console.cloud.google.com/apis/credentials
#
# 1. Create a project.
# 2. Enable the Google Drive API:
#      https://console.cloud.google.com/apis/library/drive.googleapis.com
# 3. OAuth consent screen → External (or Internal for Workspace).
#    App name: Todobee
#    Scopes to add (Data access → Add or remove scopes):
#      - openid
#      - .../auth/userinfo.email
#      - .../auth/userinfo.profile
#      - https://www.googleapis.com/auth/drive.file
#    drive.file lets Todobee create and edit only the files it creates
#    (a "Todobee" folder and workspace.json plus task attachments) in the
#    workspace admin's Drive. It does not grant access to the rest of Drive.
#    Publishing status: Testing is enough while your Google account is a test user.
#    Add every developer Google account under Test users.
# 4. Credentials → Create credentials → OAuth client ID → Web application.
#    Authorized JavaScript origins:
#      http://localhost:3000
#      http://localhost:8080
#      https://YOUR_DOMAIN
#    Authorized redirect URIs (this exact path):
#      http://localhost:3000/api/auth/google/callback
#      http://localhost:8080/api/auth/google/callback
#      https://YOUR_DOMAIN/api/auth/google/callback
# 5. "Continue with Google" always sends prompt=consent and access_type=offline
#    so Google shows the Drive permission and returns a refresh token.
#
# Saves are written to PocketBase immediately as cache. Every 1 minute
# (DRIVE_SYNC_INTERVAL_MS=60000) the API runs a sync loop that performs Drive
# operations (folder check, pending task file uploads, file deletes, and
# Todobee/workspace.json sync) until all cached changes are synced or Google
# Drive quota is reached, then waits 1 minute and repeats.
# Default is 60000 (1 minute). Minimum is 10000.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRIVE_SYNC_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# Stripe  (yearly per-seat subscription)
# Dashboard: https://dashboard.stripe.com
#
# Products → add three recurring YEARLY prices, billed per seat (quantity = seats).
# The unit amount is the yearly price of one seat:
#   Premium     $7.99  x 12 = $95.88   → 9588 cents, lookup or id into STRIPE_PRICE_PREMIUM
#   Pro         $14.99 x 12 = $179.88  → 17988 cents, STRIPE_PRICE_PRO
#   Enterprise  $79.99 x 12 = $959.88  → 95988 cents, STRIPE_PRICE_ENTERPRISE
# Currency: USD. Recurring: yearly. Usage: licensed (quantity is the seat count).
#
# Developers → API keys:
#   Secret key starts with sk_test_ or sk_live_. Never commit it.
#   The publishable key is not required; checkout is Stripe-hosted.
#
# Developers → Webhooks → Add endpoint.
#   Local (Stripe CLI, pointed at the API, not Next):
#     stripe listen --forward-to localhost:4000/api/stripe/webhook
#     Put the CLI signing secret (whsec_...) in STRIPE_WEBHOOK_SECRET.
#   Docker / production endpoint:
#     https://YOUR_DOMAIN/api/stripe/webhook
#   Events to send (select these, not "all events"):
#     checkout.session.completed
#     customer.subscription.created
#     customer.subscription.updated
#     customer.subscription.deleted
#     invoice.paid
#     invoice.payment_failed
#
# Checkout success URL (Stripe replaces the session id):
#   {APP_URL}/billing/return?session_id={CHECKOUT_SESSION_ID}
# Checkout cancel URL:
#   {APP_URL}/subscribe
# Customer portal is optional. Seat and plan changes call the Subscriptions API
# with proration: upgrades invoice immediately, downgrades wait until renewal.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# -----------------------------------------------------------------------------
# SMTP  (workspace invite emails)
# Invites are saved in the workspace either way. When these are set, a new
# invite and a resent invite are emailed to that address. The person still
# joins by choosing Continue with Google using the same email.
#
# Port 587: SMTP_SECURE=false (STARTTLS). Port 465: SMTP_SECURE=true.
# SMTP_FROM is the visible sender, for example: Todobee <invites@yourdomain.com>
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# -----------------------------------------------------------------------------
# Docker only. The entrypoint sets these; you don't need them in local .env.
# The domain proxy must target port 3000. Next.js listens on 3001 inside the
# container, and the API on 0.0.0.0:3000 forwards pages to it.
# PROXY_NEXT=1
# NEXT_ORIGIN=http://127.0.0.1:3001
# PUBLIC_PORT=3000
# PB_URL and PB_ADMIN_* still come from this file. Docker does not start PocketBase.
# -----------------------------------------------------------------------------
